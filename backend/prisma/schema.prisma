generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  id            Int       @id @default(autoincrement())
  employee_id   Int
  date          DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  login_time    DateTime  @db.Timestamptz(6)
  logout_time   DateTime? @db.Timestamptz(6)
  working_hours Decimal   @default(0) @db.Decimal(8, 2)
  hourly_rate   Decimal   @default(100) @db.Decimal(10, 2)
  daily_pay     Decimal   @default(0) @db.Decimal(10, 2)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  employees     employees @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  organization_id Int
  organization    organizations @relation(fields: [organization_id], references: [id])

  @@unique([employee_id, date], map: "attendance_employee_date_unique")
  @@index([date], map: "attendance_data_idx")
  @@index([organization_id])
}

model departments {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(120)
  description String?
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  employees   employees[]
  organization_id Int
  organization    organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, name])
  @@index([organization_id])
}

model designations {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(120)
  description String?
  employees   employees[]
  organization_id Int
  organization    organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, title])
  @@index([organization_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employee_reporting {
  id                                                          Int       @id @default(autoincrement())
  employee_id                                                 Int
  manager_employee_id                                         Int
  effective_from                                              DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  effective_to                                                DateTime? @db.Date
  employee  employees @relation("employee_reporting_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manager   employees @relation("employee_reporting_manager_employee_idToemployees", fields: [manager_employee_id], references: [id], onUpdate: NoAction)

  organization_id Int
  organization    organizations @relation(fields: [organization_id], references: [id])

  @@unique([employee_id, effective_from])
  @@index([manager_employee_id], map: "employee_reporting_manager_idx")
  @@index([organization_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employees {
  id                                                                   Int                  @id @default(autoincrement())
  user_id                                                              Int?                 @unique
  employee_number                                                      String               @db.VarChar(50)
  phone                                                                String?              @db.VarChar(30)
  department_id                                                        Int?
  designation_id                                                       Int?
  joining_date                                                         DateTime?            @db.Date
  employment_status                                                    String               @default("active") @db.VarChar(30)
  created_at                                                           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                                           DateTime             @default(now()) @db.Timestamptz(6)
  attendance                                                           attendance[]
  reporting_lines  employee_reporting[] @relation("employee_reporting_employee_idToemployees")
  direct_reports   employee_reporting[] @relation("employee_reporting_manager_employee_idToemployees")
  departments                                                          departments?         @relation(fields: [department_id], references: [id], onUpdate: NoAction)
  designations                                                         designations?        @relation(fields: [designation_id], references: [id], onUpdate: NoAction)
  users                                                                users?               @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  leave_requests                                                       leave_requests[]
  organization_id Int
  organization    organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, employee_number])
  @@index([department_id], map: "employees_department_idx")
  @@index([designation_id], map: "employees_designation_idx")
  @@index([organization_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leave_requests {
  id             Int         @id @default(autoincrement())
  employee_id    Int
  leave_type_id  Int
  start_date     DateTime    @db.Date
  end_date       DateTime    @db.Date
  reason         String
  status         String      @default("pending") @db.VarChar(20)
  reviewed_by    Int?
  reviewed_at    DateTime?   @db.Timestamptz(6)
  review_comment String?
  // Two-step approval: HR and the employee's reporting manager each decide.
  // status is approved only when both approve; one rejection rejects it.
  // manager_status is "not_required" when the employee had no manager.
  hr_status           String    @default("pending") @db.VarChar(20)
  hr_reviewed_by      Int?
  hr_reviewed_at      DateTime? @db.Timestamptz(6)
  hr_comment          String?
  manager_status      String    @default("pending") @db.VarChar(20)
  manager_reviewed_by Int?
  manager_reviewed_at DateTime? @db.Timestamptz(6)
  manager_comment     String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  employees      employees   @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leave_types    leave_types @relation(fields: [leave_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?      @relation("leave_reviewed_by", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hr_reviewer      users?    @relation("leave_hr_reviewer", fields: [hr_reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manager_reviewer users?    @relation("leave_manager_reviewer", fields: [manager_reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  organization_id Int
  organization    organizations @relation(fields: [organization_id], references: [id])

  @@index([employee_id], map: "idx_leave_requests_employee")
  @@index([status], map: "idx_leave_requests_status")
  @@index([organization_id])
}

model leave_types {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(50)
  description    String?
  is_paid        Boolean          @default(true)
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  leave_requests leave_requests[]
  organization_id Int
  organization    organizations @relation(fields: [organization_id], references: [id])

  @@unique([organization_id, name])
  @@index([organization_id])
}

/// A company using PeopleDesk. Every company-owned row points here.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model organizations {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(150)
  slug               String               @unique @db.VarChar(80)
  status             String               @default("active") @db.VarChar(20)
  plan               String               @default("free") @db.VarChar(30)
  plan_ref           plans                @relation(fields: [plan], references: [code], onUpdate: Cascade, onDelete: Restrict)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  users              users[]
  employees          employees[]
  departments        departments[]
  designations       designations[]
  leave_types        leave_types[]
  leave_requests     leave_requests[]
  attendance         attendance[]
  employee_reporting employee_reporting[]
}

model permissions {
  id               Int                @id @default(autoincrement())
  permission_key   String             @unique @db.VarChar(100)
  description      String?
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model user_roles {
  user_id     Int
  role_id     Int
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  roles       roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
  @@index([role_id], map: "user_roles_role_idx")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(150)
  email          String           @db.VarChar(255)
  password       String           @db.VarChar(255)
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  employees      employees?
  leave_requests leave_requests[] @relation("leave_reviewed_by")
  leave_hr_reviews      leave_requests[] @relation("leave_hr_reviewer")
  leave_manager_reviews leave_requests[] @relation("leave_manager_reviewer")
  user_roles     user_roles[]
  organization_id Int
  organization    organizations @relation(fields: [organization_id], references: [id])

  @@index([organization_id])
}



model platform_admins {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(150)
  email          String          @unique @db.VarChar(255)
  password       String          @db.VarChar(255) 
  is_active      Boolean         @default(true)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  
}

// Subscription plans, shared by every company (not a tenant table).
// organizations.plan holds a plan's code. Prices are whole rupees.
model plans {
  id            Int             @id @default(autoincrement())
  code          String          @unique @db.VarChar(30)
  name          String          @db.VarChar(60)
  description   String          @default("") @db.VarChar(255)
  price_monthly Int             @default(0)
  price_yearly  Int             @default(0)
  max_employees Int?
  features      String[]        @default([])
  is_active     Boolean         @default(true)
  is_featured   Boolean         @default(false)
  sort_order    Int             @default(0)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  organizations organizations[]
}
